# LLM-Anbieter: gemini | anthropic | ollama
LLM_PROVIDER=openrouter

# Modellname des gewählten Anbieters (aktuelle Namen in der Doku des Anbieters nachsehen)
LLM_MODEL= "models/gemini-2.5-flash"

# Nur der Key des gewählten Anbieters wird gebraucht
GEMINI_API_KEY=

OPENROUTER_API_KEY=

ANTHROPIC_API_KEY=

# Embeddings: bge-m3 ist stark auf Deutsch (~2 GB). Für schnelle Tests: intfloat/multilingual-e5-small
EMBEDDING_MODEL=BAAI/bge-m3

DB_PATH=data/jobby.db
QDRANT_PATH=data/qdrant
PROFILE_DIR=profile